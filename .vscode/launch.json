{
	"version": "0.2.0",
	"configurations": [
		{
			"name": "⚡ Debug: Next.js Frontend",
			"type": "node",
			"request": "launch",
			"program": "${workspaceFolder}/nextjs-frontend/node_modules/.bin/next",
			"args": ["dev"],
			"cwd": "${workspaceFolder}/nextjs-frontend",
			"env": {
				"NODE_OPTIONS": "--inspect"
			},
			"console": "integratedTerminal",
			"serverReadyAction": {
				"pattern": "Local:\\s+(https?://\\S+)",
				"uriFormat": "%s",
				"action": "debugWithChrome"
			}
		}
	]
}
