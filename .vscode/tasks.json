{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "⚡ Frontend: Start Next.js Dev Server",
			"type": "shell",
			"command": "cd nextjs-frontend && bun dev",
			"group": "build",
			"presentation": {
				"echo": true,
				"reveal": "always",
				"focus": false,
				"panel": "new",
				"showReuseMessage": true
			},
			"isBackground": true,
			"problemMatcher": {
				"pattern": {
					"regexp": ".",
					"file": 1,
					"location": 2,
					"message": 3
				},
				"background": {
					"activeOnStart": true,
					"beginsPattern": "Next.js",
					"endsPattern": "Ready in"
				}
			},
			"detail": "Start the Next.js dev server (Turbopack)"
		},
		{
			"label": "🎨 Format: Frontend (Prettier)",
			"type": "shell",
			"command": "cd nextjs-frontend && bun run format",
			"group": "build",
			"presentation": {
				"echo": true,
				"reveal": "always",
				"focus": false,
				"panel": "shared",
				"showReuseMessage": true
			},
			"problemMatcher": [],
			"detail": "Format the frontend with Prettier"
		},
		{
			"label": "🔍 Lint: Frontend (ESLint)",
			"type": "shell",
			"command": "cd nextjs-frontend && bun run lint",
			"group": "test",
			"presentation": {
				"echo": true,
				"reveal": "always",
				"focus": false,
				"panel": "shared",
				"showReuseMessage": true
			},
			"problemMatcher": [],
			"detail": "Lint the frontend with ESLint"
		},
		{
			"label": "🧪 Test: Frontend (Jest)",
			"type": "shell",
			"command": "cd nextjs-frontend && bun run test",
			"group": "test",
			"presentation": {
				"echo": true,
				"reveal": "always",
				"focus": false,
				"panel": "shared",
				"showReuseMessage": true
			},
			"problemMatcher": [],
			"detail": "Run frontend tests with Jest"
		},
		{
			"label": "🗄️ Database: Run Migrations",
			"type": "shell",
			"command": "cd nextjs-frontend && bun run db:migrate",
			"group": "build",
			"presentation": {
				"echo": true,
				"reveal": "always",
				"focus": false,
				"panel": "shared",
				"showReuseMessage": true
			},
			"problemMatcher": [],
			"detail": "Apply Drizzle migrations to the database in .env.local"
		},
		{
			"label": "🐳 Docker: Build & Start All Services",
			"type": "shell",
			"command": "docker compose up --build",
			"group": "build",
			"presentation": {
				"echo": true,
				"reveal": "always",
				"focus": false,
				"panel": "new",
				"showReuseMessage": true
			},
			"problemMatcher": [],
			"detail": "Start Postgres and the frontend in Docker"
		},
		{
			"label": "🧹 Clean: Build Artifacts",
			"type": "shell",
			"command": "cd nextjs-frontend && rm -rf .next node_modules coverage",
			"group": "build",
			"presentation": {
				"echo": true,
				"reveal": "always",
				"focus": false,
				"panel": "shared",
				"showReuseMessage": true
			},
			"problemMatcher": [],
			"detail": "Remove frontend build output and dependencies"
		}
	]
}
