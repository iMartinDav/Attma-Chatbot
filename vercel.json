{
  "buildCommand": "cd nextjs-frontend && npm install && npm run build",
  "outputDirectory": "nextjs-frontend/.next",
  "framework": "nextjs",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/nextjs-frontend/$1"
    }
  ],
  "ignoreCommand": "git diff --quiet HEAD^ HEAD ./nextjs-frontend"
}
