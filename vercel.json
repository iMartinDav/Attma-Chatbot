{
  "version": 2,
  "buildCommand": "cd nextjs-frontend && pnpm run build",
  "outputDirectory": "nextjs-frontend/.next",
  "installCommand": "cd nextjs-frontend && corepack enable && corepack pnpm install --frozen-lockfile",
  "framework": "nextjs",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/nextjs-frontend/$1"
    }
  ],
  "ignoreCommand": "git diff --quiet HEAD^ HEAD ./nextjs-frontend"
}
