# API Configuration
NEXT_PUBLIC_API_URL=https://api.attma-chatbot.com
NEXT_PUBLIC_API_VERSION=v1

# Authentication
NEXT_PUBLIC_AUTH_ENABLED=true
NEXT_PUBLIC_AUTH_COOKIE_NAME=session
NEXT_PUBLIC_AUTH_COOKIE_SECURE=true
NEXT_PUBLIC_AUTH_COOKIE_SAME_SITE=strict

# Feature Flags
NEXT_PUBLIC_ENABLE_ANALYTICS=true
NEXT_PUBLIC_ENABLE_ERROR_REPORTING=true
NEXT_PUBLIC_ENABLE_PERFORMANCE_MONITORING=true

# Development
NEXT_PUBLIC_DEV_MODE=false
NEXT_PUBLIC_DEBUG=false

# Production
NEXT_PUBLIC_SITE_URL=https://attma-chatbot.com
NEXT_PUBLIC_SITE_NAME=ATTMA Chatbot
NEXT_PUBLIC_SITE_DESCRIPTION="ATTMA Chatbot - A Next.js and FastAPI application" 