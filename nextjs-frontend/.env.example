# Copy to .env.local and fill in. Never commit real values.

# Meta Muse models (all chat, sub-agent, image and voice calls)
META_MODEL_API_KEY=
# Fallback provider, used only when META_MODEL_API_KEY is unset
OPENAI_API_KEY=

# Postgres (chats, users, reports)
POSTGRES_URL=postgresql://postgres:password@localhost:5432/mydatabase

# Auth.js
AUTH_SECRET=                # openssl rand -base64 32
AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Vercel Blob (uploads and published figures)
BLOB_READ_WRITE_TOKEN=

# Python sandbox snapshot id (scripts/sandbox/build-snapshot.ts)
ATTMA_SANDBOX_SNAPSHOT=

# Optional
RESEND_API_KEY=
EMAIL_FROM=
ALPHAGENOME_API_KEY=
PUBMED_API_KEY=
