# Docker Build Environment Values
# These are placeholder values for Docker build process only
# They will be overridden by real values at runtime

# Email Service
RESEND_API_KEY=dummy_key_for_docker_build
EMAIL_FROM=no-reply@example.com

# Database
POSTGRES_URL=postgresql://dummy:dummy@localhost:5432/dummy

# Authentication
NEXTAUTH_SECRET=dummy_nextauth_secret_for_docker_build
NEXTAUTH_URL=http://localhost:3000

# API URLs
NEXT_PUBLIC_API_URL=http://localhost:8000
API_BASE_URL=http://localhost:8000
BACKEND_URL=http://localhost:8000

# Build flags
DOCKER_BUILD=true
NEXT_TELEMETRY_DISABLED=1
