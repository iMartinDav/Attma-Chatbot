  "scripts": {
    "dev": "next dev --turbo",
    "build": "tsx lib/db/migrate && next build",
    "build:docker": "NEXT_TELEMETRY_DISABLED=1 DOCKER_BUILD=true next build",
    "build:skip-migrate": "NEXT_TELEMETRY_DISABLED=1 next build",
    "start": "next start",
    "lint": "next lint && biome lint --write --unsafe",
    "lint:fix": "next lint --fix && biome lint --write --unsafe",
    "format": "biome format --write",
    "test": "jest --passWithNoTests",
    "coverage": "jest --coverage --passWithNoTests",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "npx tsx lib/db/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "db:push": "drizzle-kit push",
    "db:pull": "drizzle-kit pull",
    "db:check": "drizzle-kit check",
    "db:up": "drizzle-kit up",
    "translate": "languine",
    "translate:prepare": "ts-node scripts/manage-translations.ts ensure-files",
    "translate:add": "ts-node scripts/manage-translations.ts add-key",
    "translate:all": "npm run translate:prepare && npm run translate",
    "email:dev": "email dev --port 3001",
    "email:build": "email build",
    "email:export": "email export"
  },
