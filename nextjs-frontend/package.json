  "packageManager": "bun@1.3.13",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "tsx lib/db/migrate && next build",
    "build:docker": "NEXT_TELEMETRY_DISABLED=1 DOCKER_BUILD=true next build",
    "build:skip-migrate": "NEXT_TELEMETRY_DISABLED=1 next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "jest --passWithNoTests",
    "release-gate": "bash scripts/release-gate.sh",
    "coverage": "jest --coverage --passWithNoTests",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun lib/db/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "db:push": "drizzle-kit push",
    "db:pull": "drizzle-kit pull",
    "db:check": "drizzle-kit check",
    "db:up": "drizzle-kit up",
    "translate": "languine",
    "translate:prepare": "ts-node scripts/manage-translations.ts ensure-files",
    "translate:add": "ts-node scripts/manage-translations.ts add-key",
    "translate:all": "bun run translate:prepare && bun run translate",
    "email:dev": "email dev --port 3001",
    "email:build": "email build",
    "email:export": "email export"
  },
